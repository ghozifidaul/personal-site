---
import '../styles/global.css';
import '@fontsource-variable/geist/wght.css';
import '@fontsource-variable/geist-mono/wght.css';
import Navbar from '../components/Navbar.astro';

interface Props {
	title?: string;
	description?: string;
	image?: string;
	type?: 'website' | 'article';
}

const {
	title = 'Ghozi Fidaul',
	description = 'Personal site of Ghozi Fidaul, a software engineer building modern web applications with clean code and creative solutions.',
	image = '/ss-personal-site.webp',
	type = 'website',
} = Astro.props;

const siteTitle = 'Ghozi Fidaul';
const pageTitle = title === siteTitle ? title : `${title} | ${siteTitle}`;

const canonicalURL = new URL(Astro.url.pathname, Astro.site).href;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/png" href="/ghozifidaul.png" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<link rel="canonical" href={canonicalURL} />
		<link rel="sitemap" href="/sitemap-index.xml" />

		<meta name="description" content={description} />
		<meta name="author" content="Ghozi Fidaul" />
		<meta name="keywords" content="Ghozi Fidaul, software engineer, web development, programming, portfolio, blog" />
		<meta name="robots" content="index, follow" />

		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={new URL(image, Astro.site)} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:type" content={type} />
		<meta property="og:site_name" content={siteTitle} />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={new URL(image, Astro.site)} />

		<title>{pageTitle}</title>
	</head>
	<body class="min-h-screen">
		<a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-[60] focus:px-4 focus:py-2 focus:bg-neutral-50 focus:text-neutral-950 focus:font-medium text-sm">
			Skip to content
		</a>
		<Navbar />
		<div class="noise-overlay" aria-hidden="true"></div>
		<slot />
	</body>
</html>
