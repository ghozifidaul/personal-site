---
import TypewriterName from './TypewriterName.tsx';
import HeroImage from './HeroImage.tsx';
---

<section class="min-h-[100dvh] flex items-end pb-16 md:pb-24 pt-32">
	<div class="mx-auto px-6 md:px-8 max-w-6xl w-full">
		<div class="grid md:grid-cols-12 gap-8 md:gap-6 items-end">
			<div class="md:col-span-8 lg:col-span-7">
				<p class="text-sm font-mono text-neutral-500 mb-6">
					Software engineer & AI product builder
				</p>
				<TypewriterName
					lines={['Ghozi', 'Fidaul']}
					className="swiss-heading text-6xl md:text-8xl lg:text-9xl font-semibold text-neutral-50 mb-8"
					client:load
				/>
				<p class="swiss-body text-lg md:text-xl text-neutral-400 max-w-md mb-10">
					Building intelligent applications with clean code and product thinking.
				</p>
				<a
					href="/experience"
					class="inline-flex items-center gap-3 px-8 py-4 bg-neutral-50 text-neutral-950 text-sm font-semibold hover:bg-accent hover:text-neutral-50 active:scale-[0.97] transition-[transform,color,background-color] duration-200 ease-out"
				>
					View selected work
					<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
						<path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
					</svg>
				</a>
			</div>
			<div class="md:col-span-4 lg:col-span-5 md:pb-4">
				<HeroImage
					src="/ghozi-black-n-white.webp"
					alt="Portrait of Ghozi Fidaul"
					client:load
				/>
			</div>
		</div>
	</div>
</section>
