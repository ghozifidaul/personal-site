---
import type { Experience } from '../types/experience';

interface Props {
	experience: Experience;
}

const { experience } = Astro.props;
---

<div class="relative pl-8 pb-12 last:pb-0">
	<div class="absolute left-[11px] top-2 bottom-0 w-px bg-neutral-200 dark:bg-neutral-800 last:hidden" />
	<div class="absolute left-0 top-2 w-[23px] h-[23px] rounded-full border-2 border-neutral-300 dark:border-neutral-700 bg-neutral-50 dark:bg-neutral-950 flex items-center justify-center">
		<div class="w-[7px] h-[7px] rounded-full bg-neutral-400 dark:bg-neutral-500" />
	</div>

	<div>
		<p class="text-sm font-mono text-neutral-500 dark:text-neutral-400 mb-1">
			{experience.period}
		</p>
		<h3 class="text-lg font-semibold text-neutral-900 dark:text-neutral-50">
			{experience.title}
		</h3>
		<p class="text-sm text-neutral-600 dark:text-neutral-400 mb-3">
			{experience.company}
		</p>
		<ul class="space-y-2 mb-4">
			{experience.highlights.map((highlight) => (
				<li class="text-sm text-neutral-600 dark:text-neutral-400 pl-4 relative">
					<span class="absolute left-0 top-[0.6em] w-1.5 h-px bg-neutral-300 dark:bg-neutral-600" />
					{highlight}
				</li>
			))}
		</ul>
		<div class="flex flex-wrap gap-2">
			{experience.tags.map((tag) => (
				<span class="px-2.5 py-1 text-[11px] font-mono border border-neutral-200 dark:border-neutral-800 text-neutral-500 dark:text-neutral-400">
					{tag}
				</span>
			))}
		</div>
	</div>
</div>
