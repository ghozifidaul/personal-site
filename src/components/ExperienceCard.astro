---
import type { Experience } from '../types/experience';

interface Props {
	experience: Experience;
}

const { experience } = Astro.props;
---

<article class="grid md:grid-cols-12 gap-4 md:gap-8 py-10 border-t border-neutral-900">
	<div class="md:col-span-3">
		<p class="text-sm font-mono text-neutral-500 tabular-nums">
			{experience.period}
		</p>
	</div>
	<div class="md:col-span-9">
		<h3 class="text-2xl md:text-3xl font-medium text-neutral-50 mb-1">
			{experience.title}
		</h3>
		<p class="text-sm text-neutral-500 mb-6">
			{experience.company}
		</p>
		<ul class="space-y-3 mb-6 max-w-2xl">
			{experience.highlights.map((highlight) => (
				<li class="text-base text-neutral-400 leading-relaxed pl-4 relative">
					<span class="absolute left-0 top-[0.75em] w-1.5 h-px bg-neutral-600" />
					{highlight}
				</li>
			))}
		</ul>
		<div class="flex flex-wrap gap-x-4 gap-y-2 text-xs font-mono text-neutral-500">
			{experience.tags.map((tag, index) => (
				<>
					<span>{tag}</span>
					{index < experience.tags.length - 1 && <span class="text-neutral-700">/</span>}
				</>
			))}
		</div>
	</div>
</article>
