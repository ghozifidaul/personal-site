---
import Layout from '../layouts/Layout.astro';
---

<Layout
	title="Page Not Found"
	description="The page you are looking for does not exist."
>
	<main id="main" class="min-h-[100dvh] flex flex-col items-start justify-center px-6 md:px-8 max-w-6xl mx-auto">
		<div class="grid md:grid-cols-12 gap-8 md:gap-8 w-full">
			<div class="md:col-span-4">
				<p class="text-sm font-mono text-neutral-500 mb-4">404</p>
			</div>
			<div class="md:col-span-8 lg:col-span-7 lg:col-start-6">
				<h1 class="swiss-heading text-5xl md:text-7xl lg:text-8xl font-semibold text-neutral-50 mb-8">
					Page not found
				</h1>
				<p class="text-lg text-neutral-400 max-w-md mb-12 leading-relaxed">
					The page you are looking for does not exist or has been moved. Try returning home or browsing the blog.
				</p>
				<div class="flex flex-col sm:flex-row gap-4">
					<a
						href="/"
						class="inline-flex items-center justify-center px-8 py-4 bg-neutral-50 text-neutral-950 text-sm font-semibold hover:bg-accent hover:text-neutral-50 active:scale-[0.97] transition-[transform,color,background-color,border-color] duration-200 ease-out"
					>
						Go home
					</a>
					<a
						href="/blog"
						class="inline-flex items-center justify-center px-8 py-4 border border-neutral-700 text-neutral-50 text-sm font-semibold hover:border-accent hover:text-accent active:scale-[0.97] transition-[transform,color,border-color] duration-200 ease-out"
					>
						Read the blog
					</a>
				</div>
			</div>
		</div>

		<footer class="py-8 mt-24 border-t border-neutral-900 w-full">
			<div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-4 text-sm text-neutral-500">
				<p>Ghozi Fidaul — © {new Date().getFullYear()}</p>
				<div class="flex items-center gap-6">
					<a href="/" class="hover:text-neutral-50 transition-colors duration-200 ease-out">Home</a>
					<a href="/experience" class="hover:text-neutral-50 transition-colors duration-200 ease-out">Experience</a>
					<a href="/blog" class="hover:text-neutral-50 transition-colors duration-200 ease-out">Blog</a>
					<a href="/contact" class="hover:text-neutral-50 transition-colors duration-200 ease-out">Contact</a>
					<a href="https://github.com/ghozifidaul" target="_blank" rel="noopener noreferrer" class="hover:text-neutral-50 transition-colors duration-200 ease-out">GitHub</a>
				</div>
			</div>
		</footer>
	</main>
</Layout>
