---
import Layout from '../../layouts/Layout.astro';
import StructuredData from '../../components/seo/StructuredData.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
const posts = allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Layout
	title="Blog"
	description="Thoughts, tutorials, and insights about software development, web technologies, and programming."
	type="website"
>
	<StructuredData
		type="Blog"
		data={{
			name: 'Ghozi Fidaul Blog',
			url: new URL('/blog', Astro.site),
			description: 'Thoughts, tutorials, and insights about software development.',
			author: 'Ghozi Fidaul',
		}}
	/>
	<main class="mx-auto px-6 max-w-4xl pt-32 pb-24">
		<section class="mb-16">
			<h1 class="text-4xl md:text-5xl font-bold tracking-tighter text-neutral-900 dark:text-neutral-50 mb-4">
				Blog
			</h1>
			<p class="text-neutral-600 dark:text-neutral-400">
				Thoughts, tutorials, and insights about software development.
			</p>
		</section>

		<section>
			<div class="space-y-6">
				{posts.map((post) => (
					<article class="border border-neutral-200 dark:border-neutral-800 hover:border-neutral-300 dark:hover:border-neutral-700 transition-colors">
						<a href={`/blog/${post.slug}`} class="block p-6">
							<div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-3">
								<time datetime={post.data.date.toISOString()} class="text-sm text-neutral-500 dark:text-neutral-400 font-mono">
									{post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
								</time>
								{post.data.tags.length > 0 && (
									<div class="flex flex-wrap gap-2">
										{post.data.tags.map((tag) => (
											<span class="px-2.5 py-1 text-[11px] font-mono border border-neutral-200 dark:border-neutral-800 text-neutral-500 dark:text-neutral-400">
												{tag}
											</span>
										))}
									</div>
								)}
							</div>
							<h2 class="text-xl font-semibold text-neutral-900 dark:text-neutral-50 mb-2 group-hover:text-neutral-600 dark:group-hover:text-neutral-300 transition-colors">
								{post.data.title}
							</h2>
							<p class="text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed">
								{post.data.description}
							</p>
						</a>
					</article>
				))}
			</div>
		</section>

		<footer class="pt-16 mt-16 border-t border-neutral-200 dark:border-neutral-800 text-center text-sm text-neutral-500 dark:text-neutral-400">
			<p>&copy; {new Date().getFullYear()} Ghozi Fidaul</p>
		</footer>
	</main>
</Layout>
