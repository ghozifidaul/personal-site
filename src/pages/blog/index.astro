---
import Layout from '../../layouts/Layout.astro';
import StructuredData from '../../components/seo/StructuredData.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
const posts = allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Layout
	title="Blog"
	description="Thoughts, tutorials, and insights about software development, web technologies, and programming."
	type="website"
>
	<StructuredData
		type="Blog"
		data={{
			name: 'Ghozi Fidaul Blog',
			url: new URL('/blog', Astro.site),
			description: 'Thoughts, tutorials, and insights about software development.',
			author: 'Ghozi Fidaul',
		}}
	/>
	<main id="main" class="mx-auto px-6 md:px-8 max-w-6xl pt-32 pb-24">
		<section class="mb-20 md:mb-28">
			<div class="grid md:grid-cols-12 gap-8 md:gap-8 items-end">
				<div class="md:col-span-8">
					<p class="text-sm font-mono text-neutral-500 mb-4">Blog</p>
					<h1 class="swiss-heading text-5xl md:text-7xl font-semibold text-neutral-50">
						Writing
					</h1>
				</div>
				<div class="md:col-span-4">
					<p class="text-neutral-400 leading-relaxed">
						Notes on software engineering, AI systems, and the craft of building for the web.
					</p>
				</div>
			</div>
		</section>

		<section>
			<div class="space-y-0">
				{posts.map((post, index) => (
					<article>
						<a
							href={`/blog/${post.slug}`}
							class="group grid md:grid-cols-12 gap-4 md:gap-8 py-10 border-t border-neutral-900 hover:bg-neutral-900/30 transition-colors -mx-4 px-4"
						>
							<div class="md:col-span-1">
								<span class="text-sm font-mono text-neutral-600">
									{String(index + 1).padStart(2, '0')}
								</span>
							</div>
							<div class="md:col-span-2">
								<time datetime={post.data.date.toISOString()} class="text-sm font-mono text-neutral-500 tabular-nums">
									{post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short' })}
								</time>
							</div>
							<div class="md:col-span-7">
								<h2 class="text-2xl md:text-3xl font-medium text-neutral-50 group-hover:text-accent transition-colors mb-3">
									{post.data.title}
								</h2>
								<p class="text-neutral-400 leading-relaxed max-w-2xl">
									{post.data.description}
								</p>
								{post.data.tags.length > 0 && (
									<div class="flex flex-wrap gap-x-3 gap-y-1 mt-4 text-xs font-mono text-neutral-500">
										{post.data.tags.map((tag, tagIndex) => (
											<>
												<span>{tag}</span>
												{tagIndex < post.data.tags.length - 1 && <span class="text-neutral-700">/</span>}
											</>
										))}
									</div>
								)}
							</div>
							<div class="md:col-span-2 flex md:justify-end">
								<span class="text-sm font-medium text-neutral-500 group-hover:text-accent transition-colors flex items-center gap-1">
									Read
									<span class="group-hover:translate-x-1 transition-transform">→</span>
								</span>
							</div>
						</a>
					</article>
				))}
			</div>
		</section>

		<footer class="pt-24 mt-24 border-t border-neutral-900">
			<div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-4 text-sm text-neutral-500">
				<p>Ghozi Fidaul — © {new Date().getFullYear()}</p>
				<div class="flex items-center gap-6">
					<a href="/" class="hover:text-neutral-50 transition-colors">Home</a>
					<a href="/blog" class="hover:text-neutral-50 transition-colors">Blog</a>
					<a href="https://github.com/ghozifidaul" target="_blank" rel="noopener noreferrer" class="hover:text-neutral-50 transition-colors">GitHub</a>
				</div>
			</div>
		</footer>
	</main>
</Layout>
