---
import Layout from '../../layouts/Layout.astro';
import StructuredData from '../../components/seo/StructuredData.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	return posts.map((post) => ({
		params: { slug: post.slug },
		props: { post },
	}));
}

const post = Astro.props.post as any;
const { Content } = await post.render();
const data = post.data;
const canonicalURL = new URL(`/blog/${post.slug}`, Astro.site).href;
const blogImage = data.image ? `/images/${data.image}` : '/ss-personal-site.webp';
---

<Layout
	title={data.title}
	description={data.description}
	image={blogImage}
	type="article"
>
	<StructuredData
		type="Article"
		data={{
			headline: data.title,
			description: data.description,
			image: new URL(blogImage, Astro.site),
			author: 'Ghozi Fidaul',
			datePublished: data.date.toISOString(),
			dateModified: data.date.toISOString(),
			url: canonicalURL,
		}}
	/>
	<main class="container mx-auto px-4 py-8 max-w-4xl">
		<article class="py-12 blog-post">
			<a href="/blog" class="text-neutral-600 dark:text-neutral-400 hover:text-neutral-900 dark:hover:text-neutral-50 transition-colors mb-8 inline-block">
				← Back to Blog
			</a>

			{data.image && (
				<img
					src={`/images/${data.image}`}
					alt={data.title}
					class="w-full rounded-lg mb-8 object-cover max-h-[400px]"
				/>
			)}

			<header class="mb-8">
				<h1 class="text-4xl md:text-6xl font-bold mb-4 text-neutral-900 dark:text-neutral-50">
					{data.title}
				</h1>
				<div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
					<time datetime={data.date.toISOString()} class="text-neutral-600 dark:text-neutral-400">
						{data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
					</time>
					{data.tags && data.tags.length > 0 && (
						<div class="flex flex-wrap gap-2">
							{data.tags.map((tag: string) => (
								<span class="px-3 py-1 text-xs border border-neutral-300 dark:border-neutral-700 rounded-full hover:bg-neutral-200 dark:hover:bg-neutral-800 transition-colors">
									{tag}
								</span>
							))}
						</div>
					)}
				</div>
			</header>

			<div class="prose prose-neutral dark:prose-invert max-w-none">
				<Content />
			</div>
		</article>

		<footer class="py-8 border-t border-neutral-200 dark:border-neutral-800 text-center text-neutral-600 dark:text-neutral-400">
			<p>&copy; 2025. Built with Astro, Tailwind, and Framer Motion.</p>
		</footer>
	</main>
</Layout>

<style>
	.blog-post {
		animation: fade-in 0.8s ease-out;
	}
	@keyframes fade-in {
		from {
			opacity: 0;
			transform: translateY(30px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}
	:global(.prose) {
		font-size: 1.125rem;
		line-height: 1.75;
	}
	:global(.prose h1) {
		font-size: 2.25rem;
		font-weight: 700;
		margin-top: 2rem;
		margin-bottom: 1rem;
	}
	:global(.prose h2) {
		font-size: 1.875rem;
		font-weight: 600;
		margin-top: 1.75rem;
		margin-bottom: 0.75rem;
	}
	:global(.prose h3) {
		font-size: 1.5rem;
		font-weight: 600;
		margin-top: 1.5rem;
		margin-bottom: 0.5rem;
	}
	:global(.prose p) {
		margin-bottom: 1rem;
	}
	:global(.prose ul) {
		list-style-type: disc;
		padding-left: 1.5rem;
		margin-bottom: 1rem;
	}
	:global(.prose li) {
		margin-bottom: 0.5rem;
	}
	:global(.prose a) {
		color: inherit;
		text-decoration: underline;
	}
	:global(.prose pre) {
		background-color: var(--color-neutral-100);
		dark:background-color: var(--color-neutral-900);
		border: 1px solid var(--color-neutral-300);
		dark:border: 1px solid var(--color-neutral-700);
		padding: 1rem;
		border-radius: 0.5rem;
		overflow-x: auto;
		margin-bottom: 1rem;
	}
	:global(.prose code) {
		background-color: var(--color-neutral-100);
		dark:background-color: var(--color-neutral-900);
		border: 1px solid var(--color-neutral-300);
		dark:border: 1px solid var(--color-neutral-700);
		padding: 0.125rem 0.375rem;
		border-radius: 0.25rem;
		font-size: 0.875em;
	}
	:global(.prose pre code) {
		background-color: transparent;
		border: none;
		padding: 0;
	}
</style>
