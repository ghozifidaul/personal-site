---
import Layout from '../../layouts/Layout.astro';
import StructuredData from '../../components/seo/StructuredData.astro';
import { ArrowLeftIcon } from '@phosphor-icons/react';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	return posts.map((post) => ({
		params: { slug: post.slug },
		props: { post },
	}));
}

const post = Astro.props.post as any;
const { Content } = await post.render();
const data = post.data;
const canonicalURL = new URL(`/blog/${post.slug}`, Astro.site).href;
const blogImage = data.image ? `/images/${data.image}` : '/ss-personal-site.webp';
---

<Layout
	title={data.title}
	description={data.description}
	image={blogImage}
	type="article"
>
	<StructuredData
		type="Article"
		data={{
			headline: data.title,
			description: data.description,
			image: new URL(blogImage, Astro.site),
			author: 'Ghozi Fidaul',
			datePublished: data.date.toISOString(),
			dateModified: data.date.toISOString(),
			url: canonicalURL,
		}}
	/>
	<main id="main" class="mx-auto px-6 md:px-8 max-w-4xl pt-32 pb-24">
		<article>
			<a
				href="/blog"
				class="inline-flex items-center gap-2 text-sm text-neutral-500 hover:text-accent transition-colors focus-visible:ring-2 focus-visible:ring-accent focus-visible:outline-none mb-16"
			>
				<ArrowLeftIcon size={14} />
				Back to writing
			</a>

			{data.image && (
				<img
					src={`/images/${data.image}`}
					alt={data.title}
					loading="eager"
					decoding="async"
					class="w-full mb-12 object-cover max-h-[60vh] grayscale contrast-125"
				/>
			)}

			<header class="mb-16">
				<h1 class="swiss-heading text-4xl md:text-6xl lg:text-7xl font-semibold text-neutral-50 mb-8">
					{data.title}
				</h1>
				<div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
					<time datetime={data.date.toISOString()} class="text-sm font-mono text-neutral-500 tabular-nums">
						{data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
					</time>
					{data.tags && data.tags.length > 0 && (
						<div class="flex flex-wrap gap-x-3 gap-y-1 text-xs font-mono text-neutral-500">
							{data.tags.map((tag: string, index: number) => (
								<>
									<span>{tag}</span>
									{index < data.tags.length - 1 && <span class="text-neutral-700">/</span>}
								</>
							))}
						</div>
					)}
				</div>
			</header>

			<div class="blog-content">
				<Content />
			</div>
		</article>

		<footer class="pt-24 mt-24 border-t border-neutral-900">
			<div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-4 text-sm text-neutral-500">
				<p>Ghozi Fidaul — © {new Date().getFullYear()}</p>
				<div class="flex items-center gap-6">
					<a href="/" class="hover:text-neutral-50 transition-colors">Home</a>
					<a href="/experience" class="hover:text-neutral-50 transition-colors">Experience</a>
					<a href="/blog" class="hover:text-neutral-50 transition-colors">Blog</a>
					<a href="/contact" class="hover:text-neutral-50 transition-colors">Contact</a>
					<a href="https://github.com/ghozifidaul" target="_blank" rel="noopener noreferrer" class="hover:text-neutral-50 transition-colors">GitHub</a>
				</div>
			</div>
		</footer>
	</main>
</Layout>

<style>
	.blog-content {
		font-size: 1.125rem;
		line-height: 1.75;
		color: var(--color-neutral-300);
	}

	.blog-content :global(h1),
	.blog-content :global(h2),
	.blog-content :global(h3),
	.blog-content :global(h4) {
		color: var(--color-neutral-50);
		text-wrap: balance;
	}

	.blog-content :global(h1) {
		font-size: 2.25rem;
		font-weight: 600;
		margin-top: 3rem;
		margin-bottom: 1.25rem;
		letter-spacing: -0.03em;
		line-height: 1.1;
	}

	.blog-content :global(h2) {
		font-size: 1.75rem;
		font-weight: 600;
		margin-top: 2.5rem;
		margin-bottom: 1rem;
		letter-spacing: -0.02em;
		line-height: 1.15;
	}

	.blog-content :global(h3) {
		font-size: 1.375rem;
		font-weight: 600;
		margin-top: 2rem;
		margin-bottom: 0.75rem;
		letter-spacing: -0.02em;
		line-height: 1.2;
	}

	.blog-content :global(p) {
		margin-bottom: 1.5rem;
	}

	.blog-content :global(ul),
	.blog-content :global(ol) {
		padding-left: 1.5rem;
		margin-bottom: 1.5rem;
	}

	.blog-content :global(li) {
		margin-bottom: 0.5rem;
	}

	.blog-content :global(a) {
		color: var(--color-accent);
		text-decoration: underline;
		text-underline-offset: 3px;
		transition: color 0.2s ease;
	}

	.blog-content :global(a:hover) {
		color: var(--color-accent-light);
	}

	.blog-content :global(pre) {
		background-color: var(--color-neutral-900);
		border: 1px solid var(--color-neutral-800);
		padding: 1.25rem;
		overflow-x: auto;
		margin-bottom: 1.5rem;
		font-size: 0.875rem;
		line-height: 1.6;
	}

	.blog-content :global(code) {
		background-color: var(--color-neutral-900);
		border: 1px solid var(--color-neutral-800);
		padding: 0.125rem 0.375rem;
		font-size: 0.875em;
		font-family: "Geist Mono Variable", ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
	}

	.blog-content :global(pre code) {
		background-color: transparent;
		border: none;
		padding: 0;
		font-size: inherit;
	}

	.blog-content :global(blockquote) {
		border-left: 2px solid var(--color-accent);
		padding-left: 1.25rem;
		margin: 2rem 0;
		font-style: italic;
		color: var(--color-neutral-400);
	}

	.blog-content :global(hr) {
		border: none;
		border-top: 1px solid var(--color-neutral-800);
		margin: 2.5rem 0;
	}

	.blog-content :global(img) {
		margin: 2rem 0;
		max-width: 100%;
		height: auto;
	}

	.blog-content :global(strong) {
		font-weight: 600;
		color: var(--color-neutral-50);
	}

	.blog-content :global(table) {
		width: 100%;
		border-collapse: collapse;
		margin: 1.5rem 0;
	}

	.blog-content :global(th),
	.blog-content :global(td) {
		border: 1px solid var(--color-neutral-800);
		padding: 0.75rem;
		text-align: left;
	}

	.blog-content :global(th) {
		font-weight: 600;
		background-color: var(--color-neutral-900);
		color: var(--color-neutral-50);
	}
</style>
