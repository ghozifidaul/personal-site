---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import StructuredData from '../components/seo/StructuredData.astro';
import AskAI from '../components/AskAI.tsx';
import ScrollReveal from '../components/ScrollReveal.tsx';
import { getCollection } from 'astro:content';

const blogPosts = (await getCollection('blog'))
	.sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
	.slice(0, 3);
---

<Layout
	title="Home"
	description='Personal site of Ghozi Fidaul, a software engineer building modern web applications with clean code and creative solutions.'
>
	<StructuredData
		type="WebSite"
		data={{
			name: 'Ghozi Fidaul',
			url: Astro.site,
			description: 'Personal site of Ghozi Fidaul, a software engineer building modern web applications with clean code and creative solutions.',
		}}
	/>

	<main id="main">
		<Hero />

		<ScrollReveal as="section" id="about" className="py-24 md:py-40 border-t border-neutral-900" client:load>
			<div class="mx-auto px-6 md:px-8 max-w-6xl">
				<div class="grid md:grid-cols-12 gap-12 md:gap-8">
					<div class="md:col-span-4">
						<p class="text-sm font-mono text-neutral-500 mb-3">01</p>
						<h2 class="swiss-heading text-4xl md:text-5xl font-semibold text-neutral-50">
							About
						</h2>
					</div>
					<div class="md:col-span-8 lg:col-span-7 lg:col-start-6">
						<div class="space-y-6 text-neutral-400 text-lg md:text-xl leading-relaxed max-w-2xl">
							<p>
								I'm an AI Product Engineer and Full-Stack Developer with experience spanning mobile, web, and AI systems. I specialize in building intelligent applications using Azure OpenAI, Next.js, and Python, with a focus on accessibility and user-centered design.
							</p>
							<p>
								My work includes architecting AI education assistants, developing cross-platform mobile apps for 20+ clients, and optimizing high-traffic retail systems. I combine technical expertise with product thinking to deliver solutions that make a real impact.
							</p>
						</div>
						<div class="mt-12">
							<p class="text-sm font-mono text-neutral-500 mb-4">Technologies</p>
							<div class="flex flex-wrap gap-x-4 gap-y-2 text-sm text-neutral-300">
								<span>Azure OpenAI</span>
								<span class="text-neutral-700">/</span>
								<span>Python</span>
								<span class="text-neutral-700">/</span>
								<span>LLMs</span>
								<span class="text-neutral-700">/</span>
								<span>React</span>
								<span class="text-neutral-700">/</span>
								<span>Next.js</span>
								<span class="text-neutral-700">/</span>
								<span>Astro</span>
								<span class="text-neutral-700">/</span>
								<span>React Native</span>
								<span class="text-neutral-700">/</span>
								<span>Flutter</span>
								<span class="text-neutral-700">/</span>
								<span>Node.js</span>
								<span class="text-neutral-700">/</span>
								<span>Laravel</span>
								<span class="text-neutral-700">/</span>
								<span>PostgreSQL</span>
								<span class="text-neutral-700">/</span>
								<span>AWS</span>
								<span class="text-neutral-700">/</span>
								<span>Azure</span>
							</div>
						</div>
					</div>
				</div>
			</div>
		</ScrollReveal>

		<ScrollReveal as="section" id="writing" className="py-24 md:py-40 border-t border-neutral-900" client:load>
			<div class="mx-auto px-6 md:px-8 max-w-6xl">
				<div class="grid md:grid-cols-12 gap-12 md:gap-8 mb-16">
					<div class="md:col-span-4">
						<p class="text-sm font-mono text-neutral-500 mb-3">02</p>
						<h2 class="swiss-heading text-4xl md:text-5xl font-semibold text-neutral-50">
							Writing
						</h2>
					</div>
					<div class="md:col-span-8 lg:col-span-7 lg:col-start-6 flex items-end">
						<a href="/blog" class="text-sm font-medium text-neutral-400 hover:text-accent transition-colors">
							View all posts →
						</a>
					</div>
				</div>

				{
					blogPosts.length > 0 ? (
						<div class="space-y-0">
							{blogPosts.map((post, index) => (
								<a
									href={`/blog/${post.slug}`}
									class="group grid md:grid-cols-12 gap-4 md:gap-8 py-8 border-t border-neutral-900 hover:bg-neutral-900/30 transition-colors -mx-4 px-4"
								>
									<div class="md:col-span-1">
										<span class="text-sm font-mono text-neutral-600">
											{String(index + 1).padStart(2, '0')}
										</span>
									</div>
									<div class="md:col-span-2">
										<time datetime={post.data.date.toISOString()} class="text-sm font-mono text-neutral-500">
											{new Date(post.data.date).toLocaleDateString('en-US', { year: 'numeric', month: 'short' })}
										</time>
									</div>
									<div class="md:col-span-6">
										<h3 class="text-xl md:text-2xl font-medium text-neutral-50 group-hover:text-accent transition-colors mb-2">
											{post.data.title}
										</h3>
										<p class="text-neutral-400 leading-relaxed max-w-lg">
											{post.data.description}
										</p>
									</div>
									<div class="md:col-span-3 flex md:justify-end">
										<span class="text-sm font-medium text-neutral-500 group-hover:text-accent transition-colors flex items-center gap-1">
											Read
											<span class="group-hover:translate-x-1 transition-transform">→</span>
										</span>
									</div>
								</a>
							))}
						</div>
					) : (
						<p class="text-neutral-500">
							Nothing here yet. Check back soon.
						</p>
					)
				}
			</div>
		</ScrollReveal>

		<footer class="py-8 border-t border-neutral-900">
			<div class="mx-auto px-6 md:px-8 max-w-6xl flex flex-col md:flex-row items-start md:items-center justify-between gap-4 text-sm text-neutral-500">
				<p>Ghozi Fidaul — © {new Date().getFullYear()}</p>
				<div class="flex items-center gap-6">
					<a href="/" class="hover:text-neutral-50 transition-colors">Home</a>
					<a href="/blog" class="hover:text-neutral-50 transition-colors">Blog</a>
					<a href="/experience" class="hover:text-neutral-50 transition-colors">Experience</a>
					<a href="/contact" class="hover:text-neutral-50 transition-colors">Contact</a>
					<a href="https://github.com/ghozifidaul" target="_blank" rel="noopener noreferrer" class="hover:text-neutral-50 transition-colors">GitHub</a>
				</div>
			</div>
		</footer>

		<AskAI client:load />
	</main>
</Layout>
