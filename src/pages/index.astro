---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import StructuredData from '../components/seo/StructuredData.astro';
import ExperienceCard from '../components/ExperienceCard.astro';
import AskAI from '../components/AskAI.tsx';
import { experiences } from '../data/experience';
---

<Layout

	title="Home"
	description='Personal site of Ghozi Fidaul, a software engineer building modern web applications with clean code and creative solutions.'
>
	<StructuredData
		type="WebSite"
		data={{
			name: 'Ghozi Fidaul',
			url: Astro.site,
			description: 'Personal site of Ghozi Fidaul, a software engineer building modern web applications with clean code and creative solutions.',
		}}
	/>
	<main class="container mx-auto px-4 py-8 max-w-4xl">
		<Hero />

		<section id="about" class="py-20 about-section">
			<h2 class="text-3xl md:text-4xl font-bold mb-8">
				<span class="border-b-4 border-neutral-900 dark:border-neutral-50">About</span>
			</h2>
			<div class="grid md:grid-cols-2 gap-8">
				<div>
					<p class="text-neutral-700 dark:text-neutral-300 mb-4">
						I'm an AI Product Engineer and Full-Stack Developer with experience spanning mobile, web, and AI systems. I specialize in building intelligent applications using Azure OpenAI, Next.js, and Python, with a focus on accessibility and user-centered design.
					</p>
					<p class="text-neutral-700 dark:text-neutral-300">
						My work includes architecting AI education assistants, developing cross-platform mobile apps for 20+ clients, and optimizing high-traffic retail systems. I combine technical expertise with product thinking to deliver solutions that make a real impact.
					</p>
				</div>
				<div>
					<h3 class="text-xl font-bold mb-4 text-neutral-900 dark:text-neutral-50">Technologies</h3>
					<ul class="space-y-2 text-neutral-700 dark:text-neutral-300">
						<li class="hover:translate-x-2 transition-transform cursor-default">Azure OpenAI / Python / LLMs</li>
						<li class="hover:translate-x-2 transition-transform cursor-default">React / Next.js / Astro</li>
						<li class="hover:translate-x-2 transition-transform cursor-default">React Native / Flutter / Mobile</li>
						<li class="hover:translate-x-2 transition-transform cursor-default">Node.js / Laravel / PostgreSQL</li>
						<li class="hover:translate-x-2 transition-transform cursor-default">AWS / Azure / Banking APIs</li>
					</ul>
				</div>
			</div>
		</section>

		<section id="experience" class="py-20 experience-section">
			<h2 class="text-3xl md:text-4xl font-bold mb-8">
				<span class="border-b-4 border-neutral-900 dark:border-neutral-50">Work Experience</span>
			</h2>
			<div class="space-y-8">
				{experiences.map((exp, index) => (
					<ExperienceCard experience={exp} index={index} />
				))}
			</div>
		</section>

		<section id="contact" class="py-20 contact-section">
			<h2 class="text-3xl md:text-4xl font-bold mb-8">
				<span class="border-b-4 border-neutral-900 dark:border-neutral-50">Contact</span>
			</h2>
			<div class="max-w-xl">
				<p class="text-neutral-700 dark:text-neutral-300 mb-8">
					I'm currently open to new opportunities and interesting challenges. Feel free to reach out!
				</p>
				<div class="space-y-4">
					<a href="mailto:ghozifidaul@gmail.com" class="flex items-center gap-4 text-neutral-700 dark:text-neutral-300 hover:text-neutral-900 dark:hover:text-neutral-50 transition-all hover:translate-x-2">
						<span class="text-2xl">✉️</span>
						<span>ghozifidaul@gmail.com</span>
					</a>
					<a href="https://github.com/ghozifidaul" target="_blank" rel="noopener noreferrer" class="flex items-center gap-4 text-neutral-700 dark:text-neutral-300 hover:text-neutral-900 dark:hover:text-neutral-50 transition-all hover:translate-x-2">
						<span class="text-2xl">🐙</span>
						<span>GitHub</span>
					</a>
					<a href="https://www.linkedin.com/in/ghozifidaul/" target="_blank" rel="noopener noreferrer" class="flex items-center gap-4 text-neutral-700 dark:text-neutral-300 hover:text-neutral-900 dark:hover:text-neutral-50 transition-all hover:translate-x-2">
						<span class="text-2xl">💼</span>
						<span>LinkedIn</span>
					</a>
				</div>
			</div>
		</section>

		<AskAI client:load />

		<footer class="py-8 border-t border-neutral-200 dark:border-neutral-800 text-center text-neutral-600 dark:text-neutral-400">
			<p>&copy; 2025. Built with Astro, Tailwind, and Framer Motion.</p>
		</footer>
	</main>
</Layout>

<style>
	.about-section {
		animation: fade-in 0.8s ease-out 0.2s both;
	}
	.experience-section {
		animation: fade-in 0.8s ease-out 0.4s both;
	}
	.contact-section {
		animation: fade-in 0.8s ease-out 0.6s both;
	}
	@keyframes fade-in {
		from {
			opacity: 0;
			transform: translateY(30px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

</style>
