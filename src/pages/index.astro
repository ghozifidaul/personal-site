---
import Layout from '../layouts/Layout.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import Hero from '../components/Hero.astro';
import StructuredData from '../components/seo/StructuredData.astro';
---

<Layout
	title="Home"
	description="Personal portfolio of a software engineer showcasing work experience and blog posts about web development, programming, and technology."
>
	<StructuredData
		type="WebSite"
		data={{
			name: 'Ghozi Fidaul',
			url: Astro.site,
			description: 'Personal portfolio of Ghozi Fidaul showcasing work experience and blog posts.',
		}}
	/>
	<ThemeToggle />
	<nav class="container mx-auto px-4 py-4 max-w-4xl">
		<ul class="flex gap-6">
			<li><a href="/" class="text-neutral-700 dark:text-neutral-300 hover:text-neutral-900 dark:hover:text-neutral-50 transition-colors">Home</a></li>
			<li><a href="/blog" class="text-neutral-700 dark:text-neutral-300 hover:text-neutral-900 dark:hover:text-neutral-50 transition-colors">Blog</a></li>
		</ul>
	</nav>
	<main class="container mx-auto px-4 py-8 max-w-4xl">
		<Hero />

		<section id="about" class="py-20 about-section">
			<h2 class="text-3xl md:text-4xl font-bold mb-8">
				<span class="border-b-4 border-neutral-900 dark:border-neutral-50">About</span>
			</h2>
			<div class="grid md:grid-cols-2 gap-8">
				<div>
					<p class="text-neutral-700 dark:text-neutral-300 mb-4">
						I'm a passionate software engineer with expertise in building scalable web applications. I focus on writing clean, maintainable code and creating seamless user experiences.
					</p>
					<p class="text-neutral-700 dark:text-neutral-300">
						When I'm not coding, you can find me exploring new technologies, contributing to open source, or sharing knowledge through technical writing.
					</p>
				</div>
				<div>
					<h3 class="text-xl font-bold mb-4 text-neutral-900 dark:text-neutral-50">Technologies</h3>
					<ul class="space-y-2 text-neutral-700 dark:text-neutral-300">
						<li class="hover:translate-x-2 transition-transform cursor-default">TypeScript / JavaScript</li>
						<li class="hover:translate-x-2 transition-transform cursor-default">React / Next.js / Astro</li>
						<li class="hover:translate-x-2 transition-transform cursor-default">Node.js / Python</li>
						<li class="hover:translate-x-2 transition-transform cursor-default">PostgreSQL / MongoDB</li>
						<li class="hover:translate-x-2 transition-transform cursor-default">AWS / Docker / Kubernetes</li>
					</ul>
				</div>
			</div>
		</section>

		<section id="experience" class="py-20 experience-section">
			<h2 class="text-3xl md:text-4xl font-bold mb-8">
				<span class="border-b-4 border-neutral-900 dark:border-neutral-50">Work Experience</span>
			</h2>
			<div class="space-y-8">
				<div class="border border-neutral-300 dark:border-neutral-700 p-6 rounded-lg hover:border-neutral-500 dark:hover:border-neutral-500 transition-all hover:scale-105 hover:shadow-lg experience-card">
					<div class="flex flex-col md:flex-row md:items-start md:justify-between gap-4 mb-4">
						<div>
							<h3 class="text-xl font-bold mb-1 text-neutral-900 dark:text-neutral-50">Senior Software Engineer</h3>
							<p class="text-neutral-600 dark:text-neutral-400">Tech Company Inc.</p>
						</div>
						<span class="text-sm text-neutral-600 dark:text-neutral-400 whitespace-nowrap">2022 - Present</span>
					</div>
					<p class="text-neutral-700 dark:text-neutral-300 mb-4">
						Leading a team of 5 engineers building scalable microservices architecture. Improved system performance by 40% and implemented CI/CD pipelines for automated deployments.
					</p>
					<div class="flex flex-wrap gap-2">
						<span class="px-3 py-1 text-xs border border-neutral-300 dark:border-neutral-700 rounded-full hover:bg-neutral-200 dark:hover:bg-neutral-800 transition-colors">TypeScript</span>
						<span class="px-3 py-1 text-xs border border-neutral-300 dark:border-neutral-700 rounded-full hover:bg-neutral-200 dark:hover:bg-neutral-800 transition-colors">Node.js</span>
						<span class="px-3 py-1 text-xs border border-neutral-300 dark:border-neutral-700 rounded-full hover:bg-neutral-200 dark:hover:bg-neutral-800 transition-colors">AWS</span>
						<span class="px-3 py-1 text-xs border border-neutral-300 dark:border-neutral-700 rounded-full hover:bg-neutral-200 dark:hover:bg-neutral-800 transition-colors">Kubernetes</span>
					</div>
				</div>
				<div class="border border-neutral-300 dark:border-neutral-700 p-6 rounded-lg hover:border-neutral-500 dark:hover:border-neutral-500 transition-all hover:scale-105 hover:shadow-lg experience-card">
					<div class="flex flex-col md:flex-row md:items-start md:justify-between gap-4 mb-4">
						<div>
							<h3 class="text-xl font-bold mb-1 text-neutral-900 dark:text-neutral-50">Software Engineer</h3>
							<p class="text-neutral-600 dark:text-neutral-400">Digital Solutions Ltd.</p>
						</div>
						<span class="text-sm text-neutral-600 dark:text-neutral-400 whitespace-nowrap">2020 - 2022</span>
					</div>
					<p class="text-neutral-700 dark:text-neutral-300 mb-4">
						Developed full-stack web applications serving 100k+ users. Built real-time features using WebSockets and implemented responsive designs with React and Tailwind CSS.
					</p>
					<div class="flex flex-wrap gap-2">
						<span class="px-3 py-1 text-xs border border-neutral-300 dark:border-neutral-700 rounded-full hover:bg-neutral-200 dark:hover:bg-neutral-800 transition-colors">React</span>
						<span class="px-3 py-1 text-xs border border-neutral-300 dark:border-neutral-700 rounded-full hover:bg-neutral-200 dark:hover:bg-neutral-800 transition-colors">Python</span>
						<span class="px-3 py-1 text-xs border border-neutral-300 dark:border-neutral-700 rounded-full hover:bg-neutral-200 dark:hover:bg-neutral-800 transition-colors">PostgreSQL</span>
						<span class="px-3 py-1 text-xs border border-neutral-300 dark:border-neutral-700 rounded-full hover:bg-neutral-200 dark:hover:bg-neutral-800 transition-colors">Docker</span>
					</div>
				</div>
				<div class="border border-neutral-300 dark:border-neutral-700 p-6 rounded-lg hover:border-neutral-500 dark:hover:border-neutral-500 transition-all hover:scale-105 hover:shadow-lg experience-card">
					<div class="flex flex-col md:flex-row md:items-start md:justify-between gap-4 mb-4">
						<div>
							<h3 class="text-xl font-bold mb-1 text-neutral-900 dark:text-neutral-50">Junior Developer</h3>
							<p class="text-neutral-600 dark:text-neutral-400">StartUp Corp</p>
						</div>
						<span class="text-sm text-neutral-600 dark:text-neutral-400 whitespace-nowrap">2018 - 2020</span>
					</div>
					<p class="text-neutral-700 dark:text-neutral-300 mb-4">
						Contributed to various client projects, learning modern web development practices. Built RESTful APIs and integrated third-party services. Participated in code reviews and agile development processes.
					</p>
					<div class="flex flex-wrap gap-2">
						<span class="px-3 py-1 text-xs border border-neutral-300 dark:border-neutral-700 rounded-full hover:bg-neutral-200 dark:hover:bg-neutral-800 transition-colors">JavaScript</span>
						<span class="px-3 py-1 text-xs border border-neutral-300 dark:border-neutral-700 rounded-full hover:bg-neutral-200 dark:hover:bg-neutral-800 transition-colors">Vue.js</span>
						<span class="px-3 py-1 text-xs border border-neutral-300 dark:border-neutral-700 rounded-full hover:bg-neutral-200 dark:hover:bg-neutral-800 transition-colors">MongoDB</span>
						<span class="px-3 py-1 text-xs border border-neutral-300 dark:border-neutral-700 rounded-full hover:bg-neutral-200 dark:hover:bg-neutral-800 transition-colors">Express</span>
					</div>
				</div>
			</div>
		</section>

		<section id="contact" class="py-20 contact-section">
			<h2 class="text-3xl md:text-4xl font-bold mb-8">
				<span class="border-b-4 border-neutral-900 dark:border-neutral-50">Contact</span>
			</h2>
			<div class="max-w-xl">
				<p class="text-neutral-700 dark:text-neutral-300 mb-8">
					I'm currently open to new opportunities and interesting challenges. Feel free to reach out!
				</p>
				<div class="space-y-4">
					<a href="mailto:ghozifidaul@gmail.com" class="flex items-center gap-4 text-neutral-700 dark:text-neutral-300 hover:text-neutral-900 dark:hover:text-neutral-50 transition-all hover:translate-x-2">
						<span class="text-2xl">✉️</span>
						<span>ghozifidaul@gmail.com</span>
					</a>
					<a href="https://github.com/ghozifidaul" target="_blank" rel="noopener noreferrer" class="flex items-center gap-4 text-neutral-700 dark:text-neutral-300 hover:text-neutral-900 dark:hover:text-neutral-50 transition-all hover:translate-x-2">
						<span class="text-2xl">🐙</span>
						<span>GitHub</span>
					</a>
					<a href="https://www.linkedin.com/in/ghozifidaul/" target="_blank" rel="noopener noreferrer" class="flex items-center gap-4 text-neutral-700 dark:text-neutral-300 hover:text-neutral-900 dark:hover:text-neutral-50 transition-all hover:translate-x-2">
						<span class="text-2xl">💼</span>
						<span>LinkedIn</span>
					</a>
				</div>
			</div>
		</section>

		<footer class="py-8 border-t border-neutral-200 dark:border-neutral-800 text-center text-neutral-600 dark:text-neutral-400">
			<p>&copy; 2025. Built with Astro, Tailwind, and Framer Motion.</p>
		</footer>
	</main>
</Layout>

<style>
	.about-section {
		animation: fade-in 0.8s ease-out 0.2s both;
	}
	.experience-section {
		animation: fade-in 0.8s ease-out 0.4s both;
	}
	.contact-section {
		animation: fade-in 0.8s ease-out 0.6s both;
	}
	@keyframes fade-in {
		from {
			opacity: 0;
			transform: translateY(30px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}
	.experience-card:nth-child(1) { animation: fade-in 0.8s ease-out 0.5s both; }
	.experience-card:nth-child(2) { animation: fade-in 0.8s ease-out 0.6s both; }
	.experience-card:nth-child(3) { animation: fade-in 0.8s ease-out 0.7s both; }
</style>
